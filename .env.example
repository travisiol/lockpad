# The Lockpad router on Robinhood Chain. Empty until deployed: the site then
# shows clean empty states and the launch form stays closed.
NEXT_PUBLIC_LOCKPAD_ROUTER=

# Robinhood Chain (defaults shown)
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Pons launch fee, display only; the router reads the live value.
NEXT_PUBLIC_LAUNCH_FEE_ETH=0.0005

# Where the launch form uploads token images (multipart POST → { uri }).
# Without it the form answers 501 and asks to remove the image.
PONS_IPFS_UPLOAD_URL=

NEXT_PUBLIC_SITE_URL=https://lockpad.fun
NEXT_PUBLIC_X_URL=https://x.com/lockpad_
